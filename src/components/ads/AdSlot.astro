---
// 广告位组件。无发布商 ID 或无 slot ID 时不渲染任何内容（申请前/配置缺失保持站点干净）。
interface Props {
  slot?: string;
  format?: string;
  responsive?: boolean;
}
const { slot = '', format = 'auto', responsive = true } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID as string | undefined;
const show = Boolean(client && slot);
---
{show && (
  <div class="ad-slot" role="region" aria-label="Advertisement">
    <span class="ad-label" data-i18n="ads.advertisementLabel">Advertisement</span>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive={responsive ? 'true' : 'false'}
    ></ins>
  </div>
)}

<style>
  .ad-slot {
    margin: 2rem 0;
    text-align: center;
    min-height: 1px;
  }
  .ad-label {
    display: block;
    font-size: .7rem;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #94a3b8;
    margin-bottom: .5rem;
  }
</style>
