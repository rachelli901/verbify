---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="cols">
      <div>
        <p class="brand-mini"><strong>Verbify</strong> — <span data-i18n="footer.description">Turn Chinese resume verbs into English action verbs. Free, browser-only, no AI, no upload.</span></p>
      </div>
      <div>
        <h4 data-i18n="footer.resources">Resources</h4>
        <ul>
          <li><a href="/guides/" data-i18n="nav.guides">Guides</a></li>
          <li><a href="/tools/resume-reviewer" data-i18n="nav.resumeReviewer">Resume Reviewer</a></li>
          <li><a href="/examples/" data-i18n="nav.examples">Examples</a></li>
          <li><a href="/contact/" data-i18n="nav.contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4 data-i18n="footer.legal">Legal</h4>
        <ul>
          <li><a href="/privacy-policy" data-i18n="footer.privacy">Privacy Policy</a></li>
          <li><a href="/terms" data-i18n="footer.terms">Terms</a></li>
          <li><a href="/disclaimer" data-i18n="footer.disclaimer">Disclaimer</a></li>
        </ul>
      </div>
    </div>
    <p class="copyright">© {year} Verbify. <span data-i18n="footer.note">Suggestions are for reference only — final content decisions are yours.</span></p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid #e2e8f0;
    background: #f8fafc;
    padding: 3rem 0 2rem;
    margin-top: 4rem;
  }
  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
  .cols { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 2rem; margin-bottom: 2rem; }
  .brand-mini { color: #334155; margin: 0 0 .35rem; }
  .meta { color: #94a3b8; font-size: .85rem; margin: 0; }
  h4 { font-size: .9rem; color: #0f172a; margin: 0 0 .75rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: .5rem; }
  a { color: #64748b; text-decoration: none; font-size: .9rem; }
  a:hover { color: #2563eb; }
  .copyright { color: #94a3b8; font-size: .8rem; border-top: 1px solid #e2e8f0; padding-top: 1.5rem; margin: 0; }
  @media (max-width: 640px) { .cols { grid-template-columns: 1fr; } }
</style>
