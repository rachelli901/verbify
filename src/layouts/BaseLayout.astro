---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import { inlineInitScript } from '../lib/i18n/init';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Verbify — turn Chinese resume verbs into English action verbs. Free, browser-only, no AI.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const slotHeader = import.meta.env.PUBLIC_ADSENSE_SLOT_HEADER as string | undefined;
const slotFooter = import.meta.env.PUBLIC_ADSENSE_SLOT_FOOTER as string | undefined;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={inlineInitScript} />
    <script>
      import { applyI18nToDocument } from '../lib/i18n/init';
      applyI18nToDocument();
      document.addEventListener('verbify:locale-change', () => applyI18nToDocument());
    </script>
    <script>
      import { loadAdSense } from '../lib/adsense';
      document.addEventListener('verbify:consent-granted', loadAdSense);
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/*
      Single-URL bilingual site: both English and Chinese are served from the
      same path and swapped client-side. hreflang alternates tell crawlers the
      page exists in both language variants. x-default covers locale-agnostic
      indexing. All point at the same canonical URL (no separate /zh/ routes).
      These resolve against Astro.site — replace the placeholder domain on deploy.
    */}
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <Header />
    <main>
      <AdSlot slot={slotHeader} />
      <div class="container">
        <slot />
      </div>
      <AdSlot slot={slotFooter} />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>

<style is:global>
  :root {
    --color-brand: #2563eb;
    --color-text: #1e293b;
    --color-muted: #64748b;
    --color-border: #e2e8f0;
    --color-bg: #ffffff;
    --color-bg-soft: #f8fafc;
    --color-surface-hover: #f1f5f9;
    --color-border-strong: #cbd5e1;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    color: var(--color-text);
    background: var(--color-bg);
    line-height: 1.7;
  }
  a { color: var(--color-brand); }
  h1, h2, h3, h4 { line-height: 1.3; }
  img, svg { max-width: 100%; }
  :focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
  }
</style>

<style>
  main { min-height: calc(100vh - 64px - 300px); }
  .container { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; }
</style>
