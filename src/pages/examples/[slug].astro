---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const examples = await getCollection('examples');
  return examples.map((ex) => ({
    params: { slug: ex.id.replace(/\.md$/, '') },
    props: { ex },
  }));
}) satisfies GetStaticPaths;

const { ex } = Astro.props;
const { Content } = await render(ex);
const { title, description, industry } = ex.data;
---
<BaseLayout title={`${title} — Verbify`} description={description}>
  <article class="example">
    <header>
      <h1>{title}</h1>
      <p class="description">{description}</p>
      <p class="industry"><span data-i18n="example.industryLabel">Industry</span>: {industry}</p>
    </header>
    <div class="fictional">
      <strong data-i18n="example.fictionalLabel">Fictional example.</strong> <span data-i18n="example.fictional">Names, companies, roles and outcomes on this page are invented. Do not copy them into your own resume.</span>
    </div>
    <div class="body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .example { max-width: 45rem; margin: 0 auto; }
  header { padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); margin-bottom: 1.5rem; }
  h1 { margin: 0 0 .75rem; font-size: clamp(1.75rem, 3vw, 2.25rem); }
  .description { color: var(--color-muted); font-size: 1.05rem; margin: 0 0 .5rem; }
  .industry { color: #94a3b8; font-size: .85rem; margin: 0; }
  .fictional { background: #fffbeb; border: 1px solid #fde68a; border-radius: 6px; padding: .75rem 1rem; margin-bottom: 2rem; font-size: .9rem; color: #92400e; }
  .body :global(h2) { margin-top: 2rem; font-size: 1.2rem; }
  .body :global(p) { margin: 1rem 0; }
  .body :global(ul) { padding-left: 1.5rem; }
  .body :global(li) { margin-bottom: .5rem; }
  .body :global(blockquote) { border-left: 3px solid var(--color-brand); margin: 1rem 0; padding: .25rem 0 .25rem 1rem; color: var(--color-muted); }
</style>
