---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const examples = await getCollection('examples');
---
<BaseLayout title="Examples — Verbify" description="Anonymous, fictional resume examples showing verb and structure improvements.">
  <header class="page-head">
    <h1 data-i18n="examples.pageTitle">Examples</h1>
    <p data-i18n="examples.pageSubtitle">Anonymous fictional examples showing how a few targeted verb and structure changes can make a resume bullet clearer and more specific.</p>
    <p class="note"><strong data-i18n="examples.noteLabel">Note</strong>: <span data-i18n="examples.note">all examples on this page are fictional. Names, companies and outcomes are invented for illustration only.</span></p>
  </header>
  <ul class="example-list">
    {examples.map((ex) => (
      <li>
        <a href={`/examples/${ex.id.replace(/\.md$/, '')}`}>
          <h2>{ex.data.title}</h2>
          <p>{ex.data.description}</p>
          <small>Industry: {ex.data.industry}</small>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .page-head { padding-bottom: 2rem; border-bottom: 1px solid var(--color-border); margin-bottom: 2rem; }
  .note { color: #b45309; background: #fffbeb; border: 1px solid #fde68a; border-radius: 6px; padding: .65rem 1rem; font-size: .9rem; }
  .example-list { list-style: none; padding: 0; margin: 0; }
  .example-list li { border-bottom: 1px solid var(--color-border); }
  .example-list a { display: block; padding: 1.25rem 0; text-decoration: none; color: inherit; }
  .example-list a:hover h2 { color: var(--color-brand); }
  .example-list h2 { margin: 0 0 .35rem; font-size: 1.2rem; }
  .example-list p { margin: 0 0 .5rem; color: var(--color-muted); }
  .example-list small { color: #94a3b8; font-size: .8rem; }
</style>
